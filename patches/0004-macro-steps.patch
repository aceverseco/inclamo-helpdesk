diff --git a/app/javascript/dashboard/extensions/macroSteps.js b/app/javascript/dashboard/extensions/macroSteps.js
new file mode 100644
index 0000000..4b1c8c1
--- /dev/null
+++ b/app/javascript/dashboard/extensions/macroSteps.js
@@ -0,0 +1,9 @@
+// Steps that an extension adds to macros, and a check before a macro runs.
+// steps: [{ key, label: () => string, description: () => string, icon,
+// available }]; a step is offered in the macro editor while `available` is not
+// false, and named in previews always. Each one runs on the server under its
+// key and takes no parameters.
+// beforeRun(macro, conversationIds): called before a macro is sent to run;
+// returns true or false, or a promise of either; false does not run it.
+// Empty in Chatwoot itself.
+export default { steps: [], beforeRun: null };
