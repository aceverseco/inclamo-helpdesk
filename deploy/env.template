# The environment of one production instance.
#
# deploy/install.sh writes /etc/inclamo-helpdesk/helpdesk.env from this file,
# once, readable by root only: the fixed part as it stands, the secrets drawn
# on the machine, the rest from what the operator gives the install (as
# environment variables of the same names). Never fill a secret in here and
# never commit a filled copy. A line that starts with `# NAME=` is optional.
#
# scripts/check-deploy-env.mjs fails when deploy/ reads a variable that is not
# listed here.

# ---------------------------------------------------------------------------
# Fixed: the same on every instance
# ---------------------------------------------------------------------------

# Only HTTPS: Rails redirects plain HTTP and marks its cookies secure.
FORCE_SSL=true
# Nobody creates an account by signing up; the first one is made at onboarding.
ENABLE_ACCOUNT_SIGNUP=false
# No counts of accounts, users, inboxes, conversations or messages to Chatwoot's hub.
DISABLE_TELEMETRY=true
# No push notifications relayed through Chatwoot's hub.
ENABLE_PUSH_RELAY_SERVER=false
# Logs go to the container's output, where Docker bounds their size.
RAILS_LOG_TO_STDOUT=true
# The database server of the stack.
POSTGRES_HOST=postgres
# The database user of the stack.
POSTGRES_USERNAME=postgres
# The database; the backup, the restore and the restore test read this name.
POSTGRES_DATABASE=chatwoot_production
# Redis of the stack; its password is REDIS_PASSWORD below.
REDIS_URL=redis://redis:6379

# ---------------------------------------------------------------------------
# Secrets: drawn by the install on the machine, never by hand, never printed
# ---------------------------------------------------------------------------

# Signs sessions and tokens.
SECRET_KEY_BASE=
# Active Record encryption; without these three the stored store credentials cannot be read.
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
# Active Record encryption, deterministic key.
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
# Active Record encryption, key derivation salt.
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=
# Password of the database user.
POSTGRES_PASSWORD=
# Password of Redis.
REDIS_PASSWORD=

# ---------------------------------------------------------------------------
# The instance
# ---------------------------------------------------------------------------

# The domain of the instance, without a scheme. It must point at this machine.
HELPDESK_DOMAIN=
# The published image, written by the install and by upgrade.sh as
# <registry>/<name>:<tag>@sha256:<digest>.
HELPDESK_IMAGE=
# Written by the install as https://<HELPDESK_DOMAIN>; links in mail use it.
FRONTEND_URL=
# Extra flags of the web server. Empty on a real instance; the install's test
# mode writes --internal-certs.
# HELPDESK_CADDY_FLAGS=

# ---------------------------------------------------------------------------
# Outgoing mail: the install does not finish without it
# ---------------------------------------------------------------------------

# The SMTP server.
SMTP_ADDRESS=
# Its port.
SMTP_PORT=587
# The sender of every message, as `Name <address>` or an address.
MAILER_SENDER_EMAIL=
# The SMTP user, when the server asks for one.
# SMTP_USERNAME=
# The SMTP password (secret).
# SMTP_PASSWORD=
# plain, login or cram_md5, when the server needs it named.
# SMTP_AUTHENTICATION=
# The HELO domain, when the server needs one.
# SMTP_DOMAIN=
# false to stop STARTTLS from being used when the server offers it.
# SMTP_ENABLE_STARTTLS_AUTO=
# none or peer; leave unset to verify the server's certificate.
# SMTP_OPENSSL_VERIFY_MODE=
# true for a server that expects TLS from the first byte (port 465).
# SMTP_SSL=
# true to require TLS.
# SMTP_TLS=

# ---------------------------------------------------------------------------
# Attachments
# ---------------------------------------------------------------------------

# s3_compatible (object storage, a versioned bucket) or local (a volume on the
# machine, carried by the nightly backup).
ACTIVE_STORAGE_SERVICE=
# The rest only with s3_compatible. The bucket.
# STORAGE_BUCKET_NAME=
# Its access key.
# STORAGE_ACCESS_KEY_ID=
# Its secret key (secret).
# STORAGE_SECRET_ACCESS_KEY=
# Its region.
# STORAGE_REGION=
# Its endpoint, with the scheme.
# STORAGE_ENDPOINT=
# true when the storage addresses buckets by path.
# STORAGE_FORCE_PATH_STYLE=

# ---------------------------------------------------------------------------
# Backups: nightly, encrypted, off the machine
# ---------------------------------------------------------------------------

# Endpoint of the S3-compatible backup target, with the scheme.
BACKUP_S3_ENDPOINT=
# Its region.
BACKUP_S3_REGION=
# The bucket, in another region than the machine.
BACKUP_S3_BUCKET=
# Its access key.
BACKUP_S3_ACCESS_KEY_ID=
# Its secret key (secret).
BACKUP_S3_SECRET_ACCESS_KEY=
# Folder inside the bucket.
BACKUP_S3_PREFIX=helpdesk
# true when the target addresses buckets by path.
# BACKUP_S3_FORCE_PATH_STYLE=
# The public `age` key (age1...) every backup is encrypted to. The private key,
# the restore key, is held outside the machine and never comes here.
BACKUP_AGE_RECIPIENT=

# ---------------------------------------------------------------------------
# Alarm
# ---------------------------------------------------------------------------

# Incoming webhook of the operator's chat (secret). A failed backup, restore
# test or upgrade posts {"text": "..."} to it.
ALERT_WEBHOOK_URL=
