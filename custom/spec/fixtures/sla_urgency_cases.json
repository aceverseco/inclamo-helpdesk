{
  "comment": "Cases of the SLA badge rule, run by the Ruby spec of Inclamo::Sla::Urgency and by the JavaScript test of badgeOf: the two must agree.",
  "cases": [
    {
      "name": "first response with time to spare",
      "timer": {
        "policy_name": "Standard",
        "stopped": false,
        "next_change_at": null,
        "first_response": {
          "state": "running",
          "target_seconds": 900,
          "remaining_seconds": 600,
          "counting": true
        },
        "resolution": {
          "state": "running",
          "target_seconds": 86400,
          "remaining_seconds": 72000,
          "counting": true
        }
      },
      "expect": [
        "first_response",
        "calm"
      ]
    },
    {
      "name": "one second before the last five minutes",
      "timer": {
        "policy_name": "Standard",
        "stopped": false,
        "next_change_at": null,
        "first_response": {
          "state": "running",
          "target_seconds": 900,
          "remaining_seconds": 301,
          "counting": true
        }
      },
      "expect": [
        "first_response",
        "calm"
      ]
    },
    {
