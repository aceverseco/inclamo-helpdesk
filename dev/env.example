# Copy to dev/.env and fill in. Never commit dev/.env.
# openssl rand -hex 64
SECRET_KEY_BASE=
FRONTEND_URL=http://localhost:3000
# Each: openssl rand -hex 32   (Active Record encryption; the store connection is refused without them)
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=
POSTGRES_HOST=postgres
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379
ENABLE_ACCOUNT_SIGNUP=false
# App provisioning (docs/app-provisioning-setup.md). Leave the secret empty
# unless a store app creates accounts on this installation: without it the
# provisioning addresses do not exist. openssl rand -hex 32, at least 32 bytes.
INCLAMO_APP_PROVISIONING_SECRET=
# The secret before a rotation, accepted next to the current one for a while.
INCLAMO_APP_PROVISIONING_SECRET_PREVIOUS=
# Signed requests accepted in an hour; the defaults are shown.
# INCLAMO_APP_PROVISIONING_PUT_LIMIT=30
# INCLAMO_APP_PROVISIONING_STORE_LIMIT=5
# INCLAMO_APP_PROVISIONING_GET_LIMIT=300
