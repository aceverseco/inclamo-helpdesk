# Copy to dev/.env and fill in. Never commit dev/.env.
# openssl rand -hex 64
SECRET_KEY_BASE=
FRONTEND_URL=http://localhost:3000
# Each: openssl rand -hex 32   (Active Record encryption; the store connection is refused without them)
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=
POSTGRES_HOST=postgres
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379
ENABLE_ACCOUNT_SIGNUP=false
# App provisioning (docs/app-provisioning-setup.md). Leave the secret empty
# unless a store app creates accounts on this installation: without it the
# provisioning addresses do not exist. openssl rand -hex 32, at least 32 bytes.
INCLAMO_APP_PROVISIONING_SECRET=
# The secret before a rotation, accepted next to the current one for a while.
INCLAMO_APP_PROVISIONING_SECRET_PREVIOUS=
# Signed requests accepted in an hour; the defaults are shown. PUTs for the
# installation, PUTs for one store (all its addresses together), status calls.
# The removal notice is not limited.
# INCLAMO_APP_PROVISIONING_PUT_LIMIT=120
# INCLAMO_APP_PROVISIONING_STORE_LIMIT=15
# INCLAMO_APP_PROVISIONING_GET_LIMIT=300
# The store app's address for store keys (docs/app-store-access.md): HTTPS, may
# carry a path prefix. A store whose provisioning request named its own
# address uses that one. Without either, provisioned accounts get no store
# connection. Read by the web and the worker processes.
INCLAMO_APP_URL=
# Seconds between two requests for a key of one store while the app gives none
# (the app's Retry-After, when longer, is kept). The default is shown.
# INCLAMO_APP_KEY_PAUSE=30
# Erasure requests (docs/app-store-erasure.md), for the installation and for
# one store, counted apart from the PUTs.
# INCLAMO_APP_PROVISIONING_ERASURE_LIMIT=60
# INCLAMO_APP_PROVISIONING_ERASURE_STORE_LIMIT=20
# Days between the app's request to erase a store and the destruction of its
# suspended account, a whole number from 0 to 21 (docs/app-provisioning-setup.md).
# INCLAMO_ERASURE_WAIT_DAYS=7
# The file completed erasures are journaled to, outside the database, so they
# can be applied again after a restore (rake inclamo:erasure:reapply). Unset:
# no journal, and a warning at each erasure.
# INCLAMO_ERASURE_JOURNAL_PATH=
